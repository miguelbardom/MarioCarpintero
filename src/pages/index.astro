---
/**
 * Raíz del sitio: redirige al idioma por defecto con una redirección estática
 * (sin servidor) y ofrece enlaces a ambos idiomas por si la redirección falla.
 */
import { defaultLang, languages, localizePath, locales, ui } from '../i18n/ui';
import { site } from '../lib/site';

const destino = localizePath('home', defaultLang);
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.nombre}</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={new URL(destino, Astro.site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localizePath('home', l), Astro.site).href} />)}
  </head>
  <body>
    <p>{ui[defaultLang]['root.choose']}:</p>
    <ul>
      {
        locales.map((l) => (
          <li>
            <a href={localizePath('home', l)} hreflang={l} lang={l}>
              {languages[l]}
            </a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
