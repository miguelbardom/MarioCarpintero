---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ConcertCard from './ConcertCard.astro';
import Figure from './Figure.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { proximos } from '../lib/conciertos';
import { esPendiente, site } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [fotoHome] = (await getCollection('fotos', (f) => f.data.usos.includes('home'))).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const conciertos = await proximos(3);

const instrumento = site.instrumento;
const instrumentoListo = instrumento && !esPendiente(instrumento.constructor) && !esPendiente(instrumento.anio);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.nombre,
  jobTitle: site.profesion[lang],
  url: new URL(localizePath('home', lang), Astro.site).href,
  ...(esPendiente(site.email) ? {} : { email: `mailto:${site.email}` }),
  knowsAbout: {
    '@type': 'Thing',
    name: t('person.instrument'),
    ...(instrumentoListo ? { description: `${instrumento.constructor}, ${instrumento.anio}` } : {}),
  },
};
const redes = site.redes.filter((r) => !esPendiente(r.url)).map((r) => r.url);
if (redes.length > 0) Object.assign(person, { sameAs: redes });

const enlaces = [
  { ruta: 'bio', titulo: t('nav.bio'), texto: t('home.bio.text') },
  { ruta: 'media', titulo: t('nav.media'), texto: t('home.media.text') },
] as const;
---

<Base lang={lang} route="home" title={t('meta.home.title')} description={t('meta.home.description')} jsonLd={person}>
  <!-- Portada -->
  <section class="mx-auto max-w-6xl sm:px-8 md:grid md:grid-cols-12 md:gap-10 md:pt-10 lg:gap-12 lg:pt-12">
    {
      fotoHome && (
        <Figure
          foto={fotoHome}
          lang={lang}
          prioridad
          sizes="(min-width: 1152px) 640px, (min-width: 1024px) 58vw, (min-width: 768px) 50vw, (min-width: 640px) calc(100vw - 4rem), 100vw"
          class="md:col-span-6 lg:col-span-7"
          imgClass="aspect-[4/5] w-full object-cover md:max-h-[85vh]"
          captionClass="px-5 sm:px-0"
        />
      )
    }
    <div class:list={['px-5 pt-10 sm:px-0 md:flex md:flex-col md:justify-end md:pt-0 md:pb-12 lg:pb-16', fotoHome ? 'md:col-span-6 lg:col-span-5' : 'md:col-span-12']}>
      <h1 class="text-5xl sm:text-6xl md:text-5xl lg:text-6xl xl:text-7xl">{site.nombre}</h1>
      <p class="mt-4 text-sm tracking-[0.25em] text-gold-700 uppercase">{site.profesion[lang]}</p>
      <span aria-hidden="true" class="mt-8 block h-px w-16 bg-gold-400"></span>
      <p class="mt-8 max-w-prose font-serif text-xl leading-relaxed text-ink sm:text-2xl md:text-xl lg:text-2xl">{site.introHome[lang]}</p>
    </div>
  </section>

  <!-- Próximos conciertos -->
  <section aria-labelledby="proximos" class="mx-auto mt-24 max-w-6xl px-5 sm:px-8 lg:mt-36">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
      <h2 id="proximos" class="text-3xl sm:text-4xl">{t('home.upcoming')}</h2>
      <a href={localizePath('schedule', lang)} class="text-sm tracking-[0.12em] text-wood-700 uppercase hover:text-wood-500">
        {t('home.upcoming.all')} <span aria-hidden="true">→</span>
      </a>
    </div>
    {
      conciertos.length > 0 ? (
        <ul class="divide-y divide-line">
          {conciertos.map((c) => (
            <li>
              <ConcertCard concierto={c} lang={lang} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="py-10 text-muted">{t('home.upcoming.none')}</p>
      )
    }
  </section>

  <!-- Bio y Media -->
  <nav aria-label={`${t('nav.bio')} · ${t('nav.media')}`} class="mx-auto mt-20 max-w-6xl px-5 sm:px-8 lg:mt-28">
    <ul class="grid gap-6 sm:grid-cols-2 sm:gap-10">
      {
        enlaces.map((e) => (
          <li>
            <a href={localizePath(e.ruta, lang)} class="group block border-t border-gold-400 pt-6 no-underline">
              <span class="block font-serif text-4xl text-wood-900 transition-colors group-hover:text-wood-500 sm:text-5xl">
                {e.titulo}
              </span>
              <span class="mt-3 flex items-center gap-2 text-sm text-muted">
                {e.texto}
                <span aria-hidden="true" class="text-gold-700 transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
