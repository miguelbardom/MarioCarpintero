---
import Base from '../layouts/Base.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} route="home" title={t('meta.home.title')} description={t('meta.home.description')}>
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-10 sm:px-8 lg:pt-24">
    <h1 class="text-5xl sm:text-6xl lg:text-7xl">{site.nombre}</h1>
    <p class="mt-3 text-sm tracking-[0.25em] text-gold-700 uppercase">{site.profesion[lang]}</p>
    <span aria-hidden="true" class="mt-8 block h-px w-16 bg-gold-400"></span>
    <p class="mt-8 max-w-prose font-serif text-xl leading-relaxed text-ink sm:text-2xl">{site.introHome[lang]}</p>
  </div>
</Base>
