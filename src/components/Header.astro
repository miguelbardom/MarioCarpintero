---
import { localizePath, locales, navItems, useTranslations, type Lang, type RouteKey } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
  route?: RouteKey;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);
const otherLangs = locales.filter((l) => l !== lang);
---

<header class="relative border-b border-line">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-5 sm:px-8 lg:py-7">
    <a href={localizePath('home', lang)} class="group no-underline">
      <span class="block font-serif text-2xl leading-none text-wood-900 sm:text-3xl">{site.nombre}</span>
      <span class="mt-1 block text-xs tracking-[0.2em] text-gold-700 uppercase">{site.profesion[lang]}</span>
    </a>

    <button
      type="button"
      class="menu-toggle -mr-2 inline-flex items-center gap-2 p-2 text-sm tracking-widest text-wood-900 uppercase lg:hidden"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-label-open={t('nav.open')}
      data-label-close={t('nav.close')}
    >
      <span class="sr-only menu-toggle-label">{t('nav.open')}</span>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path class="icon-open" d="M3 7h18M3 12h18M3 17h18"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <nav
      id="menu-principal"
      aria-label={t('nav.label')}
      class="menu absolute inset-x-0 top-[var(--header-h,5rem)] z-40 hidden border-b border-line bg-paper px-5 pb-6 sm:px-8 lg:static lg:block lg:border-0 lg:p-0"
    >
      <ul class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-7">
        {
          navItems.map((item) => (
            <li>
              <a
                href={localizePath(item, lang)}
                aria-current={item === route ? 'page' : undefined}
                class="block py-2 text-sm tracking-[0.12em] text-ink uppercase no-underline transition-colors hover:text-wood-500 aria-[current=page]:text-wood-700 aria-[current=page]:underline aria-[current=page]:decoration-gold-400 aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {t(`nav.${item}`)}
              </a>
            </li>
          ))
        }
        <li class="mt-3 border-t border-line pt-3 lg:mt-0 lg:border-0 lg:border-l lg:pt-0 lg:pl-7">
          {
            otherLangs.map((l) => (
              <a
                href={localizePath(route ?? 'home', l)}
                hreflang={l}
                lang={l}
                class="block py-2 text-sm tracking-[0.12em] text-gold-700 uppercase no-underline hover:text-wood-700"
              >
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="sr-only">{t('lang.switch')}</span>
              </a>
            ))
          }
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .menu[data-open] {
    display: block;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-principal');
  const header = document.querySelector<HTMLElement>('header');

  if (button && menu && header) {
    const label = button.querySelector('.menu-toggle-label');
    const iconOpen = button.querySelector('.icon-open');
    const iconClose = button.querySelector('.icon-close');

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) label.textContent = (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '';
      header.style.setProperty('--header-h', `${header.offsetHeight}px`);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
